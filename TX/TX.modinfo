<?xml version="1.0" encoding="utf-8"?>
<!-- Team Kick 1.0.0 (PLAN II.1). Ids, criteria and action shapes as EFV/EFV.modinfo:1-147.
     Built in chunks (PLAN II.16): chunk A has the data and the shared modules,
     chunk B the gameplay modules and AddGameplayScripts; chunk C the UI module
     and the TX_UI AddUserInterfaces action (Team window, vote popup); chunk D
     the third context (apply banner). -->
<Mod id="9ce6ba3f-a24c-48f3-b642-516121a95502" version="1">
	<Properties>
		<Name>LOC_TX_MOD_TITLE</Name>
		<Teaser>LOC_TX_MOD_TEASER</Teaser>
		<Description>LOC_TX_MOD_DESCRIPTION</Description>
		<Authors>ThePotatoTurtle</Authors>
		<AffectsSavedGames>1</AffectsSavedGames>
		<CompatibleVersions>2.0</CompatibleVersions>
	</Properties>

	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm"/>
	</Dependencies>

	<ActionCriteria>
		<Criteria id="TX_XP2">
			<GameCoreInUse>Expansion2</GameCoreInUse>
		</Criteria>
	</ActionCriteria>

	<InGameActions>
		<!-- No LoadOrder (EFV.modinfo:22-73): UpdateDatabase then runs after the GS data. -->
		<UpdateDatabase id="TX_Data" criteria="TX_XP2">
			<File>Data/TX_Notifications.sql</File>
		</UpdateDatabase>
		<UpdateIcons id="TX_Icons" criteria="TX_XP2">
			<File>Data/TX_Icons.sql</File>
		</UpdateIcons>
		<UpdateText id="TX_Text" criteria="TX_XP2">
			<File>Data/TX_Text.xml</File>
		</UpdateText>
		<!-- Shared modules for include("TX_Votes") etc. from gameplay and UI (EFV.modinfo:41-55). -->
		<ImportFiles id="TX_Imports" criteria="TX_XP2">
			<File>Scripts/TX_Config.lua</File>
			<File>Scripts/TX_Util.lua</File>
			<File>Scripts/TX_Votes.lua</File>
			<File>Scripts/TX_Store.lua</File>
			<File>Scripts/TX_Notify.lua</File>
			<File>Scripts/TX_Apply.lua</File>
			<File>UI/TX_UIShared.lua</File>
		</ImportFiles>
		<!-- Gameplay entry point: owns all TX state (PLAN II.8). -->
		<AddGameplayScripts id="TX_Gameplay" criteria="TX_XP2">
			<File>Scripts/TX_Gameplay.lua</File>
		</AddGameplayScripts>
		<!-- UI contexts (PLAN II.11): launch-bar Team button and window, vote popup,
		     apply banner (the apply seam UI, II.11c).
		     No LoadOrder; they talk through LuaEvents.TX_* after LoadGameViewStateDone. -->
		<AddUserInterfaces id="TX_UI" criteria="TX_XP2">
			<Properties>
				<Context>InGame</Context>
			</Properties>
			<File>UI/TX_TeamWindow.xml</File>
			<File>UI/TX_VotePopup.xml</File>
			<File>UI/TX_ApplyBanner.xml</File>
		</AddUserInterfaces>
	</InGameActions>

	<!-- Mod browser text (front end). These keys are defined only here, not in
	     Data/TX_Text.xml (EFV.modinfo:103-115). Public text approved by Leon for 1.0.0. -->
	<LocalizedText>
		<Text id="LOC_TX_MOD_TITLE">
			<en_US>Team Kick v1.0.0</en_US>
		</Text>
		<Text id="LOC_TX_MOD_TEASER">
			<en_US>Vote a teammate off your team in the middle of a game.</en_US>
		</Text>
		<Text id="LOC_TX_MOD_DESCRIPTION">
			<en_US>Version 1.0.0.[NEWLINE][NEWLINE]Vote a teammate off your team in the middle of a game. The kicked player plays on alone and no longer shares victory or wars with the team.[NEWLINE][NEWLINE]- Team button: on the launch bar. Shows your teammates, the open vote and past votes.[NEWLINE]- Votes: every other human teammate has to vote yes within 5 turns. One no ends the vote. AI teammates don't vote.[NEWLINE]- Secret until it passes: the player being voted on never sees the vote.[NEWLINE]- Kick modes: soft (stays allied with the team) or hard (the alliance is ended with a war and an instant peace; the grievances fall on the kicked player).[NEWLINE]- Two-player teams: no vote needed. One confirmation dissolves the team.[NEWLINE][NEWLINE]Requires Gathering Storm.[NEWLINE][NEWLINE]Known limitations:[NEWLINE]- When a kick passes, the host applies it and the game saves itself. Load that new save to see the new teams.[NEWLINE]- Ex-teammates still see each other's map. After a soft kick they also stay allied.</en_US>
		</Text>
	</LocalizedText>

	<Files>
		<File>Data/TX_Notifications.sql</File>
		<File>Data/TX_Icons.sql</File>
		<File>Data/TX_Text.xml</File>
		<File>Scripts/TX_Config.lua</File>
		<File>Scripts/TX_Util.lua</File>
		<File>Scripts/TX_Votes.lua</File>
		<File>Scripts/TX_Store.lua</File>
		<File>Scripts/TX_Notify.lua</File>
		<File>Scripts/TX_Apply.lua</File>
		<File>Scripts/TX_Gameplay.lua</File>
		<File>UI/TX_UIShared.lua</File>
		<File>UI/TX_TeamWindow.xml</File>
		<File>UI/TX_TeamWindow.lua</File>
		<File>UI/TX_VotePopup.xml</File>
		<File>UI/TX_VotePopup.lua</File>
		<File>UI/TX_ApplyBanner.xml</File>
		<File>UI/TX_ApplyBanner.lua</File>
	</Files>
</Mod>
